# Configure these only on a trusted worker host; never use EXPO_PUBLIC_ prefixes.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional absolute paths if binaries are not on PATH.
FFMPEG_PATH=
FFPROBE_PATH=

# Set true only during a write-maintenance window for destructive orphan cleanup.
MEDIA_CLEANUP_MAINTENANCE=false

# One-time private admin access for automated database migrations.
# Never use EXPO_PUBLIC_ prefixes or share these values in chat.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
