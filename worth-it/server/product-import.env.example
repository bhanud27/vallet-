# Importer-only settings. Never place database admin/service-role credentials in this file.
# Product extraction (server only). No vendor or browser rendering enabled by default.
# Production requires authenticated Supabase users. These are PUBLIC Auth settings, never an admin key.
PRODUCT_AUTH_SUPABASE_URL=
PRODUCT_AUTH_ANON_KEY=
PRODUCT_IMPORT_REQUIRE_AUTH=false
PRODUCT_EXTRACT_TIMEOUT_MS=20000
PRODUCT_POLICY_TIMEOUT_MS=5000
PRODUCT_PRICE_TTL_MS=300000
PRODUCT_IDENTITY_TTL_MS=3600000
PRODUCT_NEGATIVE_TTL_MS=30000
# Exact CDN hostnames whose image copying/storage you are authorized to use.
# Required in production for downloaded product images. Blank => manual uploads only in production.
PRODUCT_IMAGE_COPY_HOSTS=
# Optional absolute path to a reviewed connector module exporting provider definitions.
PRODUCT_PROVIDER_MODULE=
# SerpApi can incur charges. Enable only with authorization for API usage and returned data.
PRODUCT_SERPAPI_ENABLED=false
SERPAPI_API_KEY=
PRODUCT_SERPAPI_COUNTRY=in
# Exact retailer hostnames you are authorized to render. Blank disables browser fallback.
PRODUCT_BROWSER_HOSTS=
# Optional installed browser channel: chrome or msedge; otherwise a Playwright Chromium install is required.
PRODUCT_BROWSER_CHANNEL=
