{
  "expo": {
    "name": "Worth It?",
    "slug": "worth-it",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand-logo.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "icon": "./assets/brand-logo.png"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/brand-logo.png",
      "name": "Worth It?",
      "shortName": "Worth It?"
    },
    "plugins": [
      "expo-router",
      "expo-video",
      "expo-secure-store",
      "expo-image",
      "expo-asset",
      "expo-system-ui"
    ],
    "scheme": "worthit",
    "experiments": {
      "typedRoutes": false
    }
  }
}
