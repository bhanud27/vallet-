{
  "expo": {
    "name": "Worth It?",
    "slug": "worth-it",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand-logo.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Worth It? to take a product photo for your draft."
      }
    },
    "android": {
      "package": "com.worthit.app",
      "predictiveBackGestureEnabled": false,
      "icon": "./assets/brand-logo.png"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/brand-logo.png",
      "name": "Worth It?",
      "shortName": "Worth It?"
    },
    "plugins": [
      "expo-router",
      "expo-video",
      "expo-secure-store",
      "expo-image",
      "expo-asset",
      "expo-system-ui",
      [
        "expo-sharing",
        {
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "text/plain"
            ]
          },
          "ios": {
            "enabled": false
          }
        }
      ]
    ],
    "scheme": "worthit",
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "9dd779f3-ba25-4c8a-9f15-4af063221266"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/9dd779f3-ba25-4c8a-9f15-4af063221266"
    }
  }
}
