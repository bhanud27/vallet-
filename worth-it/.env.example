# Copy to .env and fill in. Leave both Supabase values empty to run in local demo mode.
# EXPO_PUBLIC_* variables are bundled into the app and visible to anyone. Only put PUBLIC values here.
# NEVER put the Supabase service_role key (or any admin key) in this project: nothing here needs it.

# Supabase → Project Settings → API → Project URL
EXPO_PUBLIC_SUPABASE_URL=
# Supabase → Project Settings → API → anon / public key (safe in the client because Row Level Security protects data)
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Public https URL of your deployed web build (used to build share links on native and when testing).
# On web the app uses its own address, so this can stay empty if you only share from the browser.
EXPO_PUBLIC_WEB_URL=
